# Copy to .env.local (ignored by git) and set the values you need. Expo inlines EXPO_PUBLIC_* variables into the
# bundle at build time: never put secrets in them.

# Game server for local development / the QA lab. Unset (default): the production server. Never point QA at production.
# EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Address the Settings "Contact" row opens (mailto:). Unset or not an email address (default): the row is hidden.
# EXPO_PUBLIC_CONTACT_EMAIL=contact@example.com
