# Copy to .env.local (ignored by git) and set the values you need. Expo inlines EXPO_PUBLIC_* variables into the
# bundle at build time: never put secrets in them.

# Game server for local development / the QA lab. Unset (default): the production server. Never point QA at production.
# EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Address the Information screen's "Contact" row opens (mailto:). Unset or not an email address (default): the row is
# hidden. This file only reaches local builds: EAS Build doesn't upload git-ignored files, so store builds read it from
# the EAS "production" environment instead (see "Deploy (EAS)" in README.md):
#   npx eas-cli env:set --name EXPO_PUBLIC_CONTACT_EMAIL --value <address> --environment production --visibility plaintext
# EXPO_PUBLIC_CONTACT_EMAIL=contact@example.com
