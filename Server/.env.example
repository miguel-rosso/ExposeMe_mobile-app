# Copy to Server/.env for local runs and adjust. Every variable is optional: unset means the default shown.
# Example values only; the production values to set on Render are in README.md ("Deploy").
# Tags: [prod] set it in production; [tuning] leave unset unless measuring says otherwise (the defaults are the
# production values); [lab] QA lab / local only, NEVER set in production.
# Numeric values are clamped to a safe range. Counts and the upload/join timings must be integers; the ms values of
# the heartbeat and HTTP timeouts are rounded. Anything else is ignored with a warning and the default applies.

# ── Process ──

# [prod: set by Render] HTTP + socket.io port. Default 3000.
PORT=3000

# [prod] "production" in production (Express runs in production mode, npm skips dev dependencies on a plain
# install). "test" (set by vitest) allows sub-second heartbeat/HTTP timeouts. Default unset.
# Only set it on Render after its build/start commands run the compiled server (README "Deploy").
# NODE_ENV=production

# [prod: set by Render] Render sets RENDER=true on its services; when TRUST_PROXY is unset that means 1 trusted proxy
# hop. Never set it by hand.
# RENDER=true

# ── Network security ──

# [prod] Reverse-proxy hops whose X-Forwarded-For is trusted for the client IP (rate limits, per-IP caps): a hop
# count, or "false" for none. Default 1 on Render (RENDER set), else 0. Must match the real proxy chain: trusting
# more hops than there are lets clients pick their own IP, so leave it unset locally.
# TRUST_PROXY=1

# [prod] Comma-separated host names the socket.io endpoint answers to (ports ignored); any other Host header is
# refused, so another domain pointed at the server (DNS rebinding) can't use it. Default unset: any Host.
# ALLOWED_HOSTS=exposeme.example.com,localhost

# ── Socket heartbeat and HTTP timeouts (ms, clamped to 1000..300000; sub-second only under NODE_ENV=test) ──

# [tuning] A silent client is dropped after at most interval + timeout. Defaults 10000 / 15000.
SOCKET_PING_INTERVAL_MS=10000
SOCKET_PING_TIMEOUT_MS=15000
# [tuning] Longest time for a whole HTTP request (body included) / for its headers. Defaults 60000 / 20000 (headers
# never longer than the request).
# HTTP_REQUEST_TIMEOUT_MS=60000
# HTTP_HEADERS_TIMEOUT_MS=20000

# ── Socket limits per IP (managers/socketGuards, middlewares/socketOrigin) ──

# [tuning] Open sockets per IP. Default 100 (several full rooms behind one Wi-Fi / carrier NAT).
# SOCKET_MAX_CONNECTIONS_PER_IP=100
# [tuning] New engine.io sessions per IP per minute. Default 300.
# SOCKET_HANDSHAKE_RATE_MAX=300
# [tuning] Joins with an unknown room code per IP within JOIN_MISS_WINDOW_MS before "Too many attempts".
# Defaults 30 per 60000 ms.
# JOIN_MISS_MAX=30
# JOIN_MISS_WINDOW_MS=60000
# [tuning] Same-network joins (a room with a connected player on the same IP) still let through per window while
# locked. Default 24.
# JOIN_EXEMPT_MAX=24
# [tuning] Misses per IPv6 /48 per window before each /64 in it is limited more tightly. Default 300.
# JOIN_MISS_PREFIX_MAX=300
# [tuning] Server-wide misses per window before every IP's limit drops to JOIN_MISS_PRESSURE_MAX. Defaults 600 / 5.
# JOIN_MISS_GLOBAL_MAX=600
# JOIN_MISS_PRESSURE_MAX=5
# [tuning] IPs and /48s tracked for missed joins (least recent forgotten first). Default 50000.
# JOIN_MISS_MAX_TRACKED=50000
# [tuning] Live rooms created from one IP (IPv6: one /64) / from all the /64s of one IPv6 /48 before creating answers
# "Server is busy". Defaults 20 / 100 (several hosts behind one NAT; one address can't fill the 5000-room cap).
# ROOMS_PER_IP_MAX=20
# ROOMS_PER_IPV6_PREFIX_MAX=100

# ── Uploads (POST /upload) ──

# [tuning] Directory for uploaded photos (tests point it at a throwaway one). Default Server/temp, also when running
# the compiled dist/. Photos only live 30 min, so Render's ephemeral disk is fine: leave it unset there.
# UPLOAD_DIR=/tmp/exposeme-uploads
# [tuning] Rate limits within UPLOAD_RATE_WINDOW_MS: rejected requests per IP, uploads per player seat, uploads per
# started room. Defaults 60000 ms, 30, 20, and 12 × UPLOAD_PLAYER_RATE_MAX (240). The QA lab raises them for load tests.
# UPLOAD_RATE_WINDOW_MS=60000
# UPLOAD_REJECTED_MAX=30
# UPLOAD_PLAYER_RATE_MAX=20
# UPLOAD_ROOM_RATE_MAX=240
# [tuning] Uploads being received at once: server-wide, per IP, per IP once half the server-wide slots are taken,
# per room, per player. Defaults 32, 12, 4, 12, 2. Memory bound ≈ UPLOAD_INFLIGHT_MAX × 5 MB.
# UPLOAD_INFLIGHT_MAX=32
# UPLOAD_INFLIGHT_PER_IP_MAX=12
# UPLOAD_INFLIGHT_PER_IP_BUSY_MAX=4
# UPLOAD_INFLIGHT_PER_ROOM_MAX=12
# UPLOAD_INFLIGHT_PER_MEMBER_MAX=2
# [tuning] Time to receive a whole upload body (ms). Default 20000.
# UPLOAD_REQUEST_TIMEOUT_MS=20000
# [tuning] Longest wait for an image-processing slot before 503 (ms). Default 60000.
# SANITIZE_QUEUE_TIMEOUT_MS=60000
# [tuning] Stored photos server-wide / lobby photos per uploader IP before new lobby photos are refused.
# Defaults 3000 / 150.
# UPLOAD_STORED_MAX=3000
# UPLOAD_LOBBY_PER_IP_MAX=150
# [tuning] A planted photo not claimed by its player within this long is deleted (ms). Default 120000.
# UPLOAD_PLANT_CLAIM_MS=120000

# ── Invite page (/join/:code) ──

# [prod, once known] The app's numeric App Store id (apps.apple.com/app/id<digits>). Set: iPhones and desktops get an
# App Store button. Unset (default): they see a "coming soon to the App Store" note instead. Google Play is always linked.
# APP_STORE_ID=1234567890

# ── Privacy policy page (/privacy) ──

# [prod] Address for privacy questions and requests, shown (as a mailto link) on the privacy policy. Unset (default)
# or not an email address: the page points to the developer contact on the store page instead.
# CONTACT_EMAIL=privacy@example.com
# [prod] Who publishes the app and is responsible for the data, as named on the policy. Unset (default): the page
# points to the developer shown on the store page instead (logged as a warning under NODE_ENV=production).
# CONTROLLER_NAME=Example Publisher

# ── Content reports (report-content, GAME_FLOW.md "Reports") ──

# [prod] JSON-lines file every accepted report is appended to; reported photos are copied to photos/ next to it.
# Default Server/reports/reports.jsonl (git-ignored). Render's disk is ephemeral (wiped on every deploy and restart):
# in production point it at a persistent disk, or rely on REPORT_WEBHOOK_URL.
# REPORTS_FILE=/var/data/exposeme/reports.jsonl
# [prod] Days a report and its photo copy are kept before they are purged (at startup and hourly). Default 90; the
# privacy policy states this value.
# REPORT_RETENTION_DAYS=90
# [tuning] Bytes the photos kept for reports may take in all (they share the disk with the uploads); past it a report
# is stored without its photo (logged, and REPORT_WEBHOOK_URL told once). Default 524288000 (500 MB).
# REPORT_PHOTOS_MAX_BYTES=524288000
# [prod] http(s) URL that gets each report as a JSON POST `{ report }` (no photo bytes), given up after 5 s.
# Default unset: no notification. It usually carries a secret token: set it only in Render's environment, never here.
# REPORT_WEBHOOK_URL=https://hooks.example.com/exposeme-reports

# ── QA lab only: NEVER set these in production ──

# [lab] 1 = accept the 3-round short game (bots and Maestro flows); the app never offers it. Default off.
# ALLOW_QA_ROUNDS=1
# [lab] 1 = record when each device acked every phase (sync metrics), to QA_TELEMETRY_FILE (JSON lines) or the
# console when no file is set. Default off.
# QA_TELEMETRY=1
# QA_TELEMETRY_FILE=../qa/runs/telemetry.jsonl
