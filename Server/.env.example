# Copy to Server/.env and adjust. All values are optional.

# HTTP + socket.io port
PORT=3000

# Socket heartbeat (ms). A silent client is dropped after at most interval + timeout.
# Clamped to 1000..300000 (sub-second values only under NODE_ENV=test).
SOCKET_PING_INTERVAL_MS=10000
SOCKET_PING_TIMEOUT_MS=15000
